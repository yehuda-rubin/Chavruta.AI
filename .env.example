# העתק ל-.env והתאם לפי הצורך.
# CHAVRUTA_PROFILE בוחר preset; כל משתנה CHAVRUTA_* עוקף שדה בודד.

# ── Docker (docker compose up --build) ───────────────────────────────────────
# הסטאק המלא (api + web) מריץ generation דרך Nebius — חובה למלא מפתח:
NEBIUS_API_KEY=your-nebius-api-key-here
# אופציונלי לעקיפה של ברירות-המחדל ב-compose (ברירת המחדל היא כבר Qwen3-235B-Instruct —
# המודל שהפרומפטים מכוונים ומאומתים מולו. שינוי כאן משנה את איכות התשובות בשקט):
# CHAVRUTA_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# CHAVRUTA_LLM_BASE_URL=https://api.studio.nebius.ai/v1
# שאר הגדרות הדוקר (profile/qdrant/db) מוזרקות ישירות ב-docker-compose.yml.

# ── Profile ──────────────────────────────────────────────────────────────────
CHAVRUTA_PROFILE=local          # local | cloud

# ── Embedding ────────────────────────────────────────────────────────────────
CHAVRUTA_EMBEDDING_MODEL=BAAI/bge-m3
CHAVRUTA_EMBEDDING_DEVICE=cpu   # cpu | cuda

# ── Vector store (Qdrant) ────────────────────────────────────────────────────
# local preset defaults: server mode via docker-compose (docker compose up -d)
# fallback to embedded: CHAVRUTA_QDRANT_MODE=embedded
CHAVRUTA_QDRANT_MODE=server
CHAVRUTA_QDRANT_URL=http://localhost:6333
# CHAVRUTA_QDRANT_PATH=data/qdrant   # used only when QDRANT_MODE=embedded
# The live production collection (100% commercially-licensed). The older mixed-licence `chavruta`
# collection was deleted 2026-07-20 — pointing here at a collection that doesn't exist gives an
# empty RAG that answers nothing, with no error to tell you why.
CHAVRUTA_COLLECTION=chavruta_commercial
CHAVRUTA_MEM_TIER=ssd           # serve the index memmapped from SSD (~1-2GB RAM instead of several)

# ── Retrieval ────────────────────────────────────────────────────────────────
CHAVRUTA_TOP_K=8
CHAVRUTA_HYBRID=false           # true = dense+sparse RRF (needs more RAM)
CHAVRUTA_RERANK=false
# CHAVRUTA_RERANK_MODEL=BAAI/bge-reranker-v2-m3
CHAVRUTA_RELEVANCE_THRESHOLD=0.3

# ── LLM — the Nebius API is the DEFAULT (the local DictaLM/Ollama backend was removed) ──────────
CHAVRUTA_LLM_BACKEND=nebius       # nebius (the API — default) | bridge (Claude in-session, no API)
CHAVRUTA_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
CHAVRUTA_LLM_BASE_URL=https://api.studio.nebius.ai/v1
CHAVRUTA_LLM_API_KEY=your-nebius-api-key-here   # or set NEBIUS_API_KEY above
CHAVRUTA_LLM_TEMPERATURE=0.2
# To run on Google Gemini's free tier instead (see docs/DEPLOY_ORACLE.md for why/when), replace the
# three lines above with a preset — same CHAVRUTA_LLM_BACKEND=nebius (it just means "OpenAI-compatible
# transport"), and drop CHAVRUTA_LLM_MODEL/_BASE_URL so the preset can fill them in:
# CHAVRUTA_LLM_PRESET=gemini
# CHAVRUTA_LLM_API_KEY=your-gemini-api-key-here   # aistudio.google.com/apikey
# No Terms/Privacy change needed for this switch — see docs/legal/REVIEW-2026-07-27.md.

# ── Query understanding ──────────────────────────────────────────────────────
# Heuristic Hebrew/landmark ref detection is always on. "llm" adds an LLM fallback, but it
# hallucinated wrong refs on this corpus — keep "heuristic".
CHAVRUTA_QUERY_PLANNER=heuristic  # heuristic | llm
# NEBIUS_API_KEY=your-nebius-api-key-here   # alias — picked up automatically

# ── Qdrant Cloud — required when CHAVRUTA_PROFILE=cloud ──────────────────────
# Create a free cluster at https://cloud.qdrant.io
# CHAVRUTA_QDRANT_API_KEY=your-qdrant-api-key-here
# CHAVRUTA_QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333

# ── Ingest Job overrides (scripts/ingest_job.py — the RAG "factory") ─────────
# INGEST_BOOKS=Genesis,Exodus        # subset of books for the Sefaria fallback
# INGEST_BATCH=64                    # embedding batch size (GPU jobs: try 128)
# INGEST_CHUNKS_PATH=data/processed/all_chunks_full.json  # reuse local corpus, skip fetch
#
# Corpus source: pull the prebuilt corpus from HF (recommended over a live Sefaria fetch)
# INGEST_CORPUS_HF_REPO=your-user/chavruta-corpus
# INGEST_CORPUS_HF_FILE=all_chunks_full.json
#
# Publish the prebuilt index to HF — the artifact end users download (bootstrap_rag.py)
# INGEST_INDEX_HF_REPO=your-user/chavruta-index
# HF_TOKEN=your-hf-write-token       # required to publish the index (and for private repos)

# ── Public hosting (all OPTIONAL — off/generous by default, tighten for a public deployment) ──
# API-key auth: comma-separated keys. UNSET = auth OFF (local dev). Set = every request needs
#   `Authorization: Bearer <key>` or `X-API-Key: <key>` (health/readiness/docs stay open).
# CHAVRUTA_API_KEYS=key-for-alice,key-for-bob
# Per-IP rate limits on the generation routes (POST /query, /sessions):
# CHAVRUTA_RATE_PER_MIN=20
# CHAVRUTA_RATE_PER_HOUR=200
# GLOBAL concurrency cap (all users combined, not per-IP) on generations actually running at once —
# sync AND async routes share this one gate (app/api.py::_run_query). Excess requests queue up to
# CHAVRUTA_QUEUE_TIMEOUT_S seconds, then degrade to a "system busy" answer instead of piling up.
# Default 2 matches a 2-vCPU free-tier box (Oracle Always Free / an HF Spaces free CPU Space) —
# raise it only if the deployment actually has the CPU/RAM to run more generations at once.
# CHAVRUTA_MAX_CONCURRENT_GENERATIONS=2
# CHAVRUTA_QUEUE_TIMEOUT_S=45
# Trusted reverse proxies in front of the API (for a spoof-proof client IP). 0 (default) = trust only
# the TCP peer and IGNORE X-Forwarded-For. Behind the shipped nginx set 1 (compose already does); add
# more only if you stack proxies (e.g. Cloudflare -> nginx -> app = 2). Too high lets clients spoof it.
# CHAVRUTA_TRUSTED_PROXY_HOPS=1
# Max request body (bytes) before a 413 (default 2MB):
# CHAVRUTA_MAX_BODY_BYTES=2097152
# Usage is metered in TWO INDEPENDENT POOLS (see docs/PLANS_AND_COUPONS.md):
#   conversation — normalized TOKENS (prompt + 3x completion), capped per day AND per week
#   lessons      — a weekly COUNT, unaffected by (and with no effect on) the token pool
# A message count would charge a pasted daf like a one-line question, which is why conversation is
# metered in tokens. NO TIER IS UNLIMITED — on a per-token product that is an open-ended liability.
# Users never see these figures: the UI shows a tier multiple and a gauge (app/plans.py).
#   defaults:  free 120k/day 350k/week 1 lesson · basic x3 · pro x10 · institution x40
# CHAVRUTA_TOKENS_DAY_FREE=120000
# CHAVRUTA_TOKENS_DAY_BASIC=360000
# CHAVRUTA_TOKENS_DAY_PRO=1200000
# CHAVRUTA_TOKENS_DAY_INSTITUTION=4800000
# CHAVRUTA_TOKENS_WEEK_FREE=350000
# CHAVRUTA_TOKENS_WEEK_BASIC=1050000
# CHAVRUTA_TOKENS_WEEK_PRO=3500000
# CHAVRUTA_TOKENS_WEEK_INSTITUTION=14000000
# CHAVRUTA_LESSONS_WEEK_FREE=1
# CHAVRUTA_LESSONS_WEEK_BASIC=3
# CHAVRUTA_LESSONS_WEEK_PRO=10
# CHAVRUTA_LESSONS_WEEK_INSTITUTION=40
# Tokens reserved up front per conversation turn (settled to the real figure afterwards). Generous
# on purpose: over-reserving only delays a user, under-reserving spends money that wasn't there.
# CHAVRUTA_TOKEN_ESTIMATE_QA=20000
# CHAVRUTA_TOKEN_ESTIMATE_COMPARE=40000
# Monthly price per tier in ILS (defaults: basic 49 · pro 169 · institution 649 — repriced
# 2026-08-12 from the old 29/49.90/199 ladder, which lost money at its own caps):
# CHAVRUTA_PRICE_BASIC=49
# CHAVRUTA_PRICE_PRO=169
# CHAVRUTA_PRICE_INSTITUTION=649
# Annual — 12 months for the price of 10 (~17% off). These are the YEAR'S TOTAL, and the year is
# charged as TWELVE MONTHLY INSTALMENTS, not up front, so that cancelling mid-year simply stops the
# next charge (see app/plans.py above ANNUAL_INSTALMENTS).
# CHAVRUTA_ANNUAL_PRICE_BASIC=489.96
# CHAVRUTA_ANNUAL_PRICE_PRO=1689.96
# CHAVRUTA_ANNUAL_PRICE_INSTITUTION=6489.96
# Days of access ONE annual instalment buys. The default is 30 and it must stay 30: an annual
# subscriber pays monthly, so setting this to 365 hands a full year of access for a single
# instalment. It exists for testing, not for "annual means a year".
# CHAVRUTA_ANNUAL_PERIOD_DAYS=30
# PayPlus's name for a yearly recurrence, if their API differs from the documented "yearly":
# PAYPLUS_ANNUAL_RECURRING_TYPE=yearly
# Credits (prepaid generations, spent once the daily quota is out). Cost per generation by intent —
# a lesson is ~10x a question in tokens, so it isn't charged the same. Set to "" to charge 1 for all:
# CHAVRUTA_CREDIT_COSTS=lesson=5,halacha=2
# Coupon redemption attempts per account per hour before a 429 (0 = no throttle):
# CHAVRUTA_COUPON_ATTEMPTS_PER_HOUR=10
# Chat retention: a conversation untouched for this many days is deleted, with its messages. Keyed
# on last activity, so a chat someone keeps returning to is never taken from under them. Saved
# lessons are NOT swept — they're the teacher's work product. 0 disables retention entirely.
# DISCLOSED to users in the Terms and the Privacy Policy — change the number, change those too.
# CHAVRUTA_CHAT_RETENTION_DAYS=90
# Timezone for the hour-of-day usage report ("when do teachers prepare?"):
# CHAVRUTA_TZ=Asia/Jerusalem
# Serve the vector index from SSD instead of RAM (default already 'ssd' — ~1-2GB for the full
#   corpus). Use 16gb/32gb/max on a bigger machine for faster queries:
# CHAVRUTA_MEM_TIER=ssd
# CORS origins for a real front-end host (comma-separated):
# CHAVRUTA_CORS_ORIGINS=https://chavruta.example.com
# DuckDNS keep-alive token (scripts/duckdns_update.sh) — only needed if the domain runs on the
# ephemeral (non-Reserved) public IP; get it from your DuckDNS domains page. See DEPLOY_ORACLE.md §4.
# DUCKDNS_TOKEN=your-duckdns-token-here

# Daily chat-history backup (scripts/backup_chat_db.sh) to Nebius Object Storage (S3-compatible).
# The corpus is NOT covered by this — see docs/DEPLOY_NEBIUS.md for the manual corpus-backup step.
# CHAVRUTA_BACKUP_BUCKET=your-bucket-name
# CHAVRUTA_BACKUP_S3_ENDPOINT=https://storage.eu-north1.nebius.cloud
# CHAVRUTA_BACKUP_RETAIN_DAYS=30

# ── Sign-in / registration via Supabase Auth (public tier) ───────────────────────────────────────
# Set SUPABASE_URL to switch the API into Supabase mode: every request then needs a valid access-token
# JWT (Authorization: Bearer <token>) minted by your Supabase project, and each user's sessions/lessons
# are scoped to their Supabase user id. UNSET = Supabase off (local dev / API-key mode unchanged).
# The JWKS endpoint, issuer, and audience are all derived from this one value.
# SUPABASE_URL=https://your-project-ref.supabase.co
# Optional overrides (rarely needed — derived from SUPABASE_URL by default):
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
# SUPABASE_JWT_AUD=authenticated
# Legacy projects that sign tokens with a shared HS256 secret instead of asymmetric keys:
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret
# Service-role key (admin scope) — OPTIONAL. If set, scheduled account deletion also removes the
# Supabase auth user (so the email can no longer sign in); without it only the app data is purged.
# Keep this SECRET — it bypasses row-level security. Never expose it to the frontend.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Account deletion grace period (days) before a requested deletion is carried out; the user can cancel
# until then. Default 30. And how often the background sweeper checks for due deletions (seconds):
# CHAVRUTA_ACCOUNT_DELETION_GRACE_DAYS=30
# CHAVRUTA_DELETION_SWEEP_INTERVAL_S=3600
#
# Frontend (web/) needs the public project URL + anon key to run the sign-in widget:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Billing — PayPlus (gateway) + Green Invoice (invoicing). All OPTIONAL: unset ⇒ billing OFF ───────
# PayPlus: sandbox until ready, then 'production'. Get the keys + payment-page UID from the PayPlus
# dashboard. The webhook is verified by an HMAC of the secret key — keep it secret.
# PAYPLUS_MODE=sandbox
# PAYPLUS_API_KEY=your-payplus-api-key
# PAYPLUS_SECRET_KEY=your-payplus-secret-key
# PAYPLUS_PAYMENT_PAGE_UID=your-payment-page-uid
# Public base URL of the deployed app — PayPlus posts the callback and redirects the user back here:
# CHAVRUTA_PUBLIC_URL=https://chavruta.example.com
# Subscription price (ILS), description (shown on the invoice), and billing period (days):
# CHAVRUTA_SUB_PRICE_ILS=49.9
# CHAVRUTA_SUB_DESCRIPTION=חברותא AI — מנוי חודשי
# CHAVRUTA_SUB_PERIOD_DAYS=30
# Green Invoice / Morning — auto-issues the tax invoice/receipt off each charge (best-effort). Get an
# API key (id + secret) from the Green Invoice dashboard; the מספר-הקצאה linkage is a one-time dashboard step.
# GREENINVOICE_MODE=sandbox
# GREENINVOICE_CLIENT_ID=your-green-invoice-api-key-id
# GREENINVOICE_CLIENT_SECRET=your-green-invoice-api-key-secret

# ── Admin dashboard + error tracking. Both OPTIONAL: unset ⇒ off ─────────────────────────────────────
# Comma-separated Supabase owner_ids allowed to see /admin (no wildcard — unlike the calendar beta
# gate, admin access should never mean "everyone"):
# CHAVRUTA_ADMIN_OWNERS=your-owner-id
# The sugya game (docs/SUGYA_GAME.md) — a guided path through one sugya, one source per level.
# Comma-separated owner_ids, or "*" once it is open to everyone. Empty means nobody, and its routes
# return 404 rather than 403 for anyone outside the list: an unreleased feature should not tell
# people it exists.
# CHAVRUTA_SUGYA_BETA_OWNERS=your-owner-id
# Cost per MILLION normalized tokens (prompt + 3x completion), in whatever currency the panel
# shows. Unset means the admin panel reports tokens only and no money — deliberately, because a
# guessed rate renders an authoritative-looking figure that is not. Set it to your provider's
# actual price to turn the spend column into a cost.
# CHAVRUTA_COST_PER_M_TOKENS=0.9
# Sentry DSN (backend only) — sign up free at sentry.io, create a Python/FastAPI project, paste its DSN:
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Email sending via Resend (operator broadcasts). OPTIONAL: unset ⇒ off ───────────────────────────────
# Used for operator-initiated broadcasts (e.g. policy updates), not auth/transactional emails.
# Get an API key at https://resend.com — the free tier supports 100 emails/day.
# RESEND_API_KEY=your-resend-api-key-here
# RESEND_FROM=chavruta@yourdomain.com   # sender address; use @resend.dev for initial testing
