# Chavruta.AI — frontend image: the Next.js app (web/), built standalone and run by Node.
#
# Build context is the repo root:
#   docker build -f docker/Dockerfile.web -t chavruta-web:latest .
#
# This replaced a build of the deprecated Vite SPA under app/frontend/, which stopped being the
# product's UI some time ago — so `docker compose up` was serving an application nobody was
# developing. `output: "standalone"` (next.config.mjs) emits a self-contained server carrying only
# the dependencies it actually uses, so the runtime image needs no npm install and no dev tree.
#
# It runs BEHIND the nginx edge (docker/nginx.conf), which terminates the client connection, caps
# the body size, and appends the real client IP. The API's per-IP rate limiter reads that hop
# (CHAVRUTA_TRUSTED_PROXY_HOPS), so publishing this container directly instead would make every
# request in the system look like it came from one address.

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app
COPY web/package.json web/package-lock.json* ./
# The dev tree (typescript, tailwind, eslint) is needed to build and reaches no further than here.
RUN npm ci

COPY web/ ./
ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* vars are inlined into the client bundle by `next build` — container `environment:`
# (docker-compose.yml) is runtime, too late for an already-frozen bundle, so a value has to reach
# THIS stage as a build ARG instead.
#
# Written to .env.production.local, and ONLY when actually provided — never as a plain `ENV`. An
# unconditional `ENV NEXT_PUBLIC_SUPABASE_URL=$ARG` (even when $ARG is empty) puts an EMPTY string
# into process.env, and Next.js's env precedence puts process.env above every `.env*` file — so it
# would SHADOW a real value this repo already keeps in `web/.env.production` (present on the deploy
# host, git-ignored, loaded natively by `next build`; root .env / docker-compose `environment:` was
# never the mechanism actually in use here). Caught live 2026-08-26: exactly that shadowing blanked
# a working Supabase config and took auth down site-wide for one deploy, immediately rolled back.
# Writing to the file conditionally means an empty ARG (this deployment) leaves the real file alone,
# while a deployment that DOES configure via docker-compose build.args still gets it baked in.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
RUN { [ -n "$NEXT_PUBLIC_SUPABASE_URL" ] && echo "NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL"; \
      [ -n "$NEXT_PUBLIC_SUPABASE_ANON_KEY" ] && echo "NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY"; \
      true; } >> .env.production.local

RUN npm run build

# ── Stage 2: run ─────────────────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# The standalone bundle, plus the two asset trees it deliberately does not inline.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

USER node

EXPOSE 3000
CMD ["node", "server.js"]
