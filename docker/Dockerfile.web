# Chavruta.AI — frontend image: the Next.js app (web/), built standalone and run by Node.
#
# Build context is the repo root:
#   docker build -f docker/Dockerfile.web -t chavruta-web:latest .
#
# This replaced a build of the deprecated Vite SPA under app/frontend/, which stopped being the
# product's UI some time ago — so `docker compose up` was serving an application nobody was
# developing. `output: "standalone"` (next.config.mjs) emits a self-contained server carrying only
# the dependencies it actually uses, so the runtime image needs no npm install and no dev tree.
#
# It runs BEHIND the nginx edge (docker/nginx.conf), which terminates the client connection, caps
# the body size, and appends the real client IP. The API's per-IP rate limiter reads that hop
# (CHAVRUTA_TRUSTED_PROXY_HOPS), so publishing this container directly instead would make every
# request in the system look like it came from one address.

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app
COPY web/package.json web/package-lock.json* ./
# The dev tree (typescript, tailwind, eslint) is needed to build and reaches no further than here.
RUN npm ci

COPY web/ ./
ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* vars are inlined into the client bundle by `next build` — container `environment:`
# (docker-compose.yml) is runtime, too late for an already-frozen bundle, so a value has to reach
# THIS stage as a build ARG instead.
#
# TWO separate traps here, not one — both caught live 2026-08-26, taking Supabase auth down
# site-wide, immediately rolled back:
#
# 1) An unconditional `ENV NEXT_PUBLIC_SUPABASE_URL=$ARG` (even when $ARG is empty) puts an EMPTY
#    string into process.env, and Next.js's env precedence puts process.env above every `.env*`
#    file — so it SHADOWS the real value this repo already keeps in `web/.env.production` (present
#    on the deploy host, git-ignored, loaded natively by `next build`; root .env / docker-compose
#    `environment:` was never the mechanism actually in use here). Fixed by writing to
#    .env.production.local instead of a plain ENV, and only when the ARG is actually non-empty.
#
# 2) That fix alone still wasn't enough: BuildKit injects any EXPLICITLY-PASSED `ARG` — even an
#    empty one — into the process environment of every later RUN in this stage, with no `ENV`
#    instruction needed (verified directly: `env | grep SUPABASE` shows the var, empty, the moment
#    docker-compose passes `--build-arg NEXT_PUBLIC_SUPABASE_URL=` via its `${VAR:-}` default —
#    which it ALWAYS does, never omits the flag). So `npm run build` below still saw an empty
#    process.env value and the shadowing happened anyway, file-write logic notwithstanding. Fixed
#    by explicitly `unset`ting the ARG-sourced var, in the SAME RUN as `npm run build`, whenever
#    it's empty — that's the only way `next build`'s process genuinely never sees it, since a fresh
#    RUN re-injects the ARG independently every time (unsetting in an earlier separate RUN would
#    not carry forward).
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
RUN if [ -n "$NEXT_PUBLIC_SUPABASE_URL" ]; then \
      echo "NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL" >> .env.production.local; \
    else \
      unset NEXT_PUBLIC_SUPABASE_URL; \
    fi; \
    if [ -n "$NEXT_PUBLIC_SUPABASE_ANON_KEY" ]; then \
      echo "NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY" >> .env.production.local; \
    else \
      unset NEXT_PUBLIC_SUPABASE_ANON_KEY; \
    fi; \
    npm run build

# ── Stage 2: run ─────────────────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# The standalone bundle, plus the two asset trees it deliberately does not inline.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

USER node

EXPOSE 3000
CMD ["node", "server.js"]
