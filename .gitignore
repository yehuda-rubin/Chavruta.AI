# ---- Logs ----
*.log
logs/
build_log_full.txt
build_vectordb.log
fetch_sefaria.log

# ---- Data & artifacts ----
data/
# Keep the template configs (small, essential — they are code, not bulk data)
!data/lesson_templates.yaml
!data/shut_templates.yaml
# PACKAGE data under src/ ships with the code and must never be caught by the bare `data/` above,
# which matches a directory of that name at ANY depth. It already silently excluded
# corpus/data/licenses.json — the table attribution is resolved from — so the code would have worked
# locally and rendered no credit line at all in Docker or CI, which is the exact bug it fixes.
# (Git will not descend into an ignored directory, so the directory itself has to be un-ignored too.)
!src/chavruta/*/data/
!src/chavruta/*/data/*.json
*.csv
*.tsv
*.parquet
*.feather
*.jsonl
# Keep the versioned evaluation datasets (Principle V — trustworthiness is measured)
!eval/
!eval/**/*.jsonl

