# Incremental capture of the agentic-loop log line — see scripts/agentic_log_capture.sh.
#
# A systemd timer rather than cron for the same reason as chavruta-nightly-eval: the `chavruta`
# user is not in /etc/cron.allow on this host.
#
# Install (from the repo root on the VM):
#     sudo cp scripts/systemd/chavruta-agentic-log-capture.* /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now chavruta-agentic-log-capture.timer
#
# Check:  systemctl list-timers chavruta-agentic-log-capture.timer
#         journalctl -u chavruta-agentic-log-capture.service --since today

[Unit]
Description=Capture Chavruta.AI agentic-loop request log incrementally
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=chavruta
WorkingDirectory=/home/chavruta/chavruta
ExecStart=/home/chavruta/chavruta/scripts/agentic_log_capture.sh
Nice=19
TimeoutStartSec=2m

[Install]
WantedBy=multi-user.target
