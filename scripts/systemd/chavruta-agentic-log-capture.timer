# Wakes the capture script every 15 minutes — the container's own docker log driver rotates at
# 50MB total (max-size:10m, max-file:5), which held only ~18h of history on this box's traffic at
# the time this was set up. Losing that window loses the "before" baseline needed to compare
# against once the nightly retrieval tuning (nightly_eval.py) is actually applied.

[Unit]
Description=Wake the Chavruta.AI agentic-loop log capture

[Timer]
OnCalendar=*-*-* *:0/15:00
Persistent=true
RandomizedDelaySec=30
Unit=chavruta-agentic-log-capture.service

[Install]
WantedBy=timers.target
